{
  "name": "notes_app",
  "version": "1.0.0",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "notes_app",
      "version": "1.0.0",
      "license": "ISC",
      "workspaces": [
        "apps/*",
        "packages/*"
      ]
    },
    "apps/api": {
      "name": "@notes/api",
      "version": "1.0.0",
      "license": "ISC",
      "dependencies": {
        "@notes/shared": "^1.0.0"
      }
    },
    "node_modules/@notes/api": {
      "resolved": "apps/api",
      "link": true
    },
    "node_modules/@notes/shared": {
      "resolved": "packages/shared",
      "link": true
    },
    "packages/shared": {
      "name": "@notes/shared",
      "version": "1.0.0",
      "license": "ISC",
      "devDependencies": {}
    }
  }
}
